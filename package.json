{
  "name": "@xwkh/mongo-cli",
  "version": "0.1.4",
  "description": "Agent-friendly MongoDB CLI backed by mongosh, with local credentials and a companion skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xwkh/mongo-cli.git"
  },
  "homepage": "https://github.com/xwkh/mongo-cli#readme",
  "bugs": {
    "url": "https://github.com/xwkh/mongo-cli/issues"
  },
  "keywords": [
    "mongodb",
    "mongosh",
    "cli",
    "ai",
    "agents",
    "codex"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "mongo-cli": "bin/mongo-cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "check": "node --check src/cli.js && node --check src/worker.cjs && npm test",
    "prepublishOnly": "npm run check"
  },
  "license": "MIT",
  "devDependencies": {
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
